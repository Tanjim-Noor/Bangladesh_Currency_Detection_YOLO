# =============================================================================
# Docker Build Ignore File
# =============================================================================
# Excludes unnecessary files from Docker build context
# =============================================================================

# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv
ENV
env

# Jupyter
.ipynb_checkpoints
*.ipynb

# IDE
.vscode
.idea
*.swp
*.swo

# Phase 1 (not needed in container)
phase1/

# Documentation files (not needed in container)
*.md
!README.md

# Test files (not needed in production)
phase2/tests/
pytest.ini
.pytest_cache

# Docker files (avoid recursive copy)
phase2/docker/Dockerfile
phase2/docker/docker-compose.yml
phase2/docker/.dockerignore

# Misc
.DS_Store
Thumbs.db
*.log
*.tmp
